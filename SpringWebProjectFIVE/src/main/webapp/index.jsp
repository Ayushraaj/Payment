<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Google Product Search</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: Arial, sans-serif;
}

body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#ffffff;
}

.container{
    text-align:center;
}

.logo{
    font-size:70px;
    font-weight:bold;
    margin-bottom:25px;
}

.blue{
    color:#4285F4;
}

.red{
    color:#EA4335;
}

.yellow{
    color:#FBBC05;
}

.green{
    color:#34A853;
}

.message{
    margin-bottom:25px;
    color:#555;
    font-size:18px;
}

.search-box{
    width:500px;
    max-width:90%;
    padding:15px;
    border:1px solid #dcdcdc;
    border-radius:30px;
    box-shadow:0 1px 6px rgba(32,33,36,.28);
    margin:auto;
    margin-bottom:30px;
}

.search-box:hover{
    box-shadow:0 2px 10px rgba(32,33,36,.35);
}

.login-btn{
    text-decoration:none;
    background:#4285F4;
    color:white;
    padding:12px 30px;
    border-radius:5px;
    font-size:16px;
    transition:0.3s;
}

.login-btn:hover{
    background:#3367D6;
}

.footer{
    margin-top:130px;
    color:#777;
    font-size:14px;
}

</style>

</head>
<body>

<div class="container">

    <div class="logo">
        <span class="red">T</span>
        <span class="red">u</span>
        <span class="red">k</span>
        <span class="blue">T</span>
        <span class="blue">u</span>
        <span class="blue">k</span>
    </div>

    <div class="message">
        Search 
        <span class="red">Tuk</span>
        <span class="blue">Tuk</span>
         Product Details with One Click
    </div>


    <a href="search" class="login-btn">
        Login Here
    </a>

    <div class="footer">
        Powered by
         <span class="red">Tuk</span>
        <span class="blue">Tuk</span>
         copyright @2026
    </div>
    
    

</div>

</body>
</html>